{
  "manifest": {
    "name": "Notes",
    "version": "1.0.0",
    "author": "DomainOS",
    "description": "A simple notes app with local storage.",
    "category": "utility",
    "icon": null,
    "longDescription": "Create, edit, and delete notes. All data is saved locally in your browser.",
    "tags": ["notes", "productivity", "text"],
    "permissions": ["storage"],
    "width": 500,
    "height": 600,
    "resizable": true
  },
  "code": "document.addEventListener('tata-ready', function() {\n  const app = document.getElementById('app');\n  let notes = JSON.parse(tata.storage.get('notes') || '[]');\n  let editingId = null;\n\n  function save() { tata.storage.set('notes', JSON.stringify(notes)); }\n  function render() {\n    const list = notes.map(n => '<div class=\"note-item\" data-id=\"' + n.id + '\"><div class=\"note-title\">' + (n.title || 'Untitled') + '</div><div class=\"note-preview\">' + (n.body || '').slice(0, 60) + '</div><div class=\"note-actions\"><button class=\"note-edit\" data-id=\"' + n.id + '\">✏️</button><button class=\"note-del\" data-id=\"' + n.id + '\">🗑</button></div></div>').join('');\n    app.innerHTML = '<div class=\"notes\"><div class=\"notes-header\"><h3>📝 Notes</h3><button id=\"new-note\" class=\"notes-new\">+ New</button></div><div class=\"notes-list\" id=\"notes-list\">' + (notes.length ? list : '<p class=\"notes-empty\">No notes yet.</p>') + '</div><div class=\"notes-editor\" id=\"notes-editor\" style=\"display:none\"><input id=\"note-title\" class=\"notes-title-input\" placeholder=\"Title\"><textarea id=\"note-body\" class=\"notes-body-input\" placeholder=\"Write something...\"></textarea><div class=\"notes-editor-btns\"><button id=\"note-save\" class=\"notes-save\">Save</button><button id=\"note-cancel\" class=\"notes-cancel\">Cancel</button></div></div></div>';\n    document.getElementById('new-note').onclick = () => { editingId = null; showEditor('', ''); };\n    document.querySelectorAll('.note-edit').forEach(b => { b.onclick = () => { const n = notes.find(x => x.id === b.dataset.id); if (n) { editingId = n.id; showEditor(n.title, n.body); } };\n    });\n    document.querySelectorAll('.note-del').forEach(b => { b.onclick = () => { notes = notes.filter(x => x.id !== b.dataset.id); save(); render(); };\n    });\n    document.getElementById('note-save').onclick = () => {\n      const title = document.getElementById('note-title').value;\n      const body = document.getElementById('note-body').value;\n      if (editingId) { const n = notes.find(x => x.id === editingId); if (n) { n.title = title; n.body = body; } }\n      else { notes.unshift({ id: Date.now().toString(), title, body, created: new Date().toISOString() }); }\n      save(); render();\n    };\n    document.getElementById('note-cancel').onclick = () => { document.getElementById('notes-editor').style.display = 'none'; document.getElementById('notes-list').style.display = '';\n    };\n  }\n  function showEditor(title, body) {\n    document.getElementById('notes-list').style.display = 'none';\n    const ed = document.getElementById('notes-editor'); ed.style.display = '';\n    document.getElementById('note-title').value = title;\n    document.getElementById('note-body').value = body;\n  }\n  render();\n  tata.log('Notes loaded');\n});",
  "css": ".notes { font-family: -apple-system, sans-serif; max-width: 480px; margin: 0 auto; padding: 16px; }\n.notes-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }\n.notes-header h3 { margin: 0; color: #1a1a2e; }\n.notes-new { padding: 8px 16px; border: none; border-radius: 8px; background: #667eea; color: #fff; font-weight: 600; cursor: pointer; }\n.notes-new:hover { background: #5a6fd6; }\n.notes-list { display: flex; flex-direction: column; gap: 8px; }\n.note-item { padding: 12px; background: #f8f9fa; border-radius: 8px; border: 1px solid #e9ecef; display: flex; align-items: center; gap: 12px; }\n.note-title { font-weight: 600; min-width: 100px; color: #1a1a2e; }\n.note-preview { flex: 1; color: #6c757d; font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.note-actions { display: flex; gap: 4px; }\n.note-actions button { background: none; border: none; cursor: pointer; font-size: 1rem; padding: 4px; }\n.notes-empty { color: #adb5bd; text-align: center; padding: 40px 0; }\n.notes-editor { display: flex; flex-direction: column; gap: 12px; }\n.notes-title-input, .notes-body-input { padding: 12px; border: 1px solid #dee2e6; border-radius: 8px; font-family: inherit; font-size: 1rem; }\n.notes-body-input { min-height: 200px; resize: vertical; }\n.notes-editor-btns { display: flex; gap: 8px; }\n.notes-save { padding: 10px 20px; border: none; border-radius: 8px; background: #22c55e; color: #fff; font-weight: 600; cursor: pointer; }\n.notes-cancel { padding: 10px 20px; border: 1px solid #dee2e6; border-radius: 8px; background: #fff; cursor: pointer; }",
  "html": "<div id=\"app\"><p style=\"padding:20px;\">Loading...</p></div>"
}
